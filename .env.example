# Copy this file to .env and edit it. Everything is optional except the two marked REQUIRED.

# ---- Who can use the helpdesk -------------------------------------------------------------
# REQUIRED. Normal users must give an email on this domain (no @). Leave empty only for testing: any domain is then accepted.
COMPANY_EMAIL_DOMAIN=fortressghana.com

# REQUIRED on first start. The first admin account, created only if no admin exists yet.
# Sign in at /admin. If ADMIN_PASSWORD is empty a random one is generated and printed ONCE in `docker compose logs helpdesk`.
# Either way you are asked to choose your own password at first sign-in.
ADMIN_EMAIL=it.admin@fortressghana.com
ADMIN_PASSWORD=

# ---- Network ------------------------------------------------------------------------------
# Port on the host machine (inside the container it is always 3000).
HOST_PORT=3000
# Who may reach that port: 0.0.0.0 = the whole network (the default, fine at the office). Use 127.0.0.1 on a server with Caddy in front.
HOST_BIND=0.0.0.0
# For the built-in HTTPS (docker compose --profile https up -d): the name people type, WITHOUT https://, already pointing at this server.
# Then also set APP_URL=https://<that name> and TRUST_PROXY=1 below.
APP_DOMAIN=
# The address people use, e.g. https://helpdesk.fortressghana.com. Used for links in emails; https turns on "Secure" cookies.
APP_URL=
# Set to 1 when the app sits behind a reverse proxy (nginx, Traefik, Caddy) that adds X-Forwarded-* headers.
TRUST_PROXY=0
# Other addresses the helpdesk answers on, comma separated (for example the name AND the NAS's IP, or the old and the new name).
# The one-click hardware report tries the address the person is using first and then these, so a changed IP or a renamed
# helpdesk does not break it.
ALT_URLS=

# ---- Email notifications ("your ticket changed") --------------------------------------------
# Pick ONE way to send. If none is set, notifications are simply off.
MAIL_FROM=helpdesk@fortressghana.com

# (a) SMTP: Microsoft 365 is smtp.office365.com / 587 with SMTP AUTH enabled for the mailbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

# (b) Microsoft Graph (an Entra app registration with the Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# For trying things out: print emails to the log instead of sending them (1 = on)
MAIL_LOG_ONLY=0
# IT staff are emailed about something in the bell only if they have NOT read it after this many seconds (so no email while they are
# at the helpdesk). 0 = email straight away.
STAFF_EMAIL_DELAY_SECONDS=120

# ---- Sign in with Microsoft 365 (optional, recommended) --------------------------------------
# Easier: fill this in under Admin > System > "Sign in with Microsoft 365" (it shows the redirect address to register and a Test button).
# These lines are only the starting point; what is saved on that page overrides them.
# An Entra app registration: tenant (directory) ID, application (client) ID and a client secret value.
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# 1 = Microsoft is the ONLY way in (no PINs, no agent passwords; admins keep a local password). Switch on from the System page
# after you have tested it with your own account, not here.
# SSO_ENFORCED=0

# ---- Tickets by email (optional) ------------------------------------------------------------
# An email to the helpdesk mailbox becomes a ticket; a reply to one of our emails becomes a message on that ticket.
# (a) Microsoft 365: the mailbox to read. Uses the GRAPH_* app registration above, which also needs the Mail.ReadWrite
#     application permission. Usually the same address as GRAPH_SENDER, so replies come straight back.
INBOUND_MAILBOX=
INBOUND_INTERVAL_SECONDS=60
# (b) Anything else that can POST JSON to /api/inbound/email with "Authorization: Bearer <this>" (16+ characters).
INBOUND_SECRET=

# ---- Calls and screen sharing (optional) -------------------------------------------------------
# Calls work by themselves when the helpdesk is on HTTPS and the computers can reach each other (one office network).
# Only if they cannot (separate VLANs or sites that block computer-to-computer traffic): a TURN relay on your own
# network, for example coturn. Several addresses may be separated by commas.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ---- Advanced -----------------------------------------------------------------------------
# Signing key for sessions. Leave empty: one is generated once and kept in the data volume.
SESSION_SECRET=
NOTIFY_INTERVAL_SECONDS=30

# Cookies are marked Secure automatically when APP_URL starts with https. If TLS ends at a proxy and APP_URL is http, set 1 here.
# Leave this line commented out unless you need it: an empty value means "off".
# COOKIE_SECURE=1

# Staff sign-in attempts allowed per address per 10 minutes (the default is fine).
# LOGIN_RATE_LIMIT=15

# How long the admin activity log is kept, in days.
AUDIT_RETENTION_DAYS=365

# Largest file a person can attach to a ticket, in megabytes (1-50).
MAX_UPLOAD_MB=10

# ---- Update check (optional; easier under Admin > System > Updates, which overrides these) -----------
# Which GitHub repository to compare against, as owner/name. A private one needs a read-only token (Contents: read-only).
UPDATE_REPO=
UPDATE_BRANCH=main
UPDATE_TOKEN=

# ---- One-button updates (optional) ----------------------------------------------------------------
# Lets an admin press "Update now" under Admin > System > Updates. Needs the updater helper:  docker compose --profile updater up -d --build
# UPDATER_SECRET: any long random text (16+ characters); it is the password between the helpdesk and the helper.
# HELPDESK_DIR: the folder holding docker-compose.yml on THIS machine, written in full (e.g. /volume1/docker/helpdesk). It must be a git clone.
UPDATER_SECRET=
HELPDESK_DIR=

# ---- Backups ----------------------------------------------------------------------------------
# Every day after BACKUP_HOUR (UTC, which is Ghana time) the database is copied and compressed, and the newest BACKUP_KEEP are
# kept, together with a copy of the uploaded files. Admin > System shows the state and lets you download them.
# By default they go to a folder inside the data volume: that survives a bad update but NOT losing the disk. For real safety
# mount another disk or a NAS share into the container (see docker-compose.yml) and point BACKUP_DIR at it, e.g. /backups.
BACKUP_ENABLED=1
BACKUP_HOUR=2
BACKUP_KEEP=14
BACKUP_DIR=
